{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "v3 holidays flat list — gen01 (pre-AI)",
	"type": "array",
	"items": {
		"type": "object",
		"required": [
			"id",
			"day",
			"month",
			"name",
			"usual",
			"description",
			"country",
			"url",
			"mature_content",
			"categories"
		],
		"properties": {
			"id": {
				"type": "string",
				"pattern": "^(fixed|floating)-\\d+$"
			},
			"day": {
				"type": "integer",
				"minimum": 1,
				"maximum": 31
			},
			"month": {
				"type": "integer",
				"minimum": 1,
				"maximum": 12
			},
			"name": {
				"type": "string"
			},
			"usual": {
				"type": "boolean"
			},
			"description": {
				"type": [
					"string",
					"null"
				]
			},
			"country": {
				"type": [
					"string",
					"null"
				],
				"pattern": "^[A-Z]{2}$"
			},
			"url": {
				"type": [
					"string",
					"null"
				]
			},
			"mature_content": {
				"type": "boolean"
			},
			"categories": {
				"type": "array",
				"items": {
					"type": "string"
				}
			}
		}
	}
}
