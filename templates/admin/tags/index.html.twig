{% extends 'base.html.twig' %}
{% block title %}Tags — Ferrio Admin{% endblock %}
{% block body %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Tags'} %}
		<div class='manage-content'>
			<h2 class='manage-page-title'>Tags</h2>

			{% for label, messages in app.flashes(['success', 'error']) %}
				{% for message in messages %}
					<div class='alert alert-{{ label == 'error' ? 'danger' : 'success' }} alert-dismissible fade show'
					     role='alert'>
						{{ message }}
						<button type='button' class='btn-close' data-bs-dismiss='alert' aria-label='Close'></button>
					</div>
				{% endfor %}
			{% endfor %}

			<form method='post' action='{{ path('admin_tags_create') }}' class='mb-4 d-flex gap-2'
			      style='max-width: 480px'>
				<input
						type='text'
						name='slug'
						class='form-control manage-input'
						placeholder='New tag slug (e.g. religious)'
						maxlength='63'
						required
				>
				<button type='submit' class='btn btn-primary'>
					<i class='bi bi-plus-lg'></i> Add
				</button>
			</form>

			{% if tags is empty %}
				<p class='text-muted'>No tags yet.</p>
			{% else %}
				<div class='table-responsive'>
					<table class='table table-dark table-striped table-hover align-middle tags-table'>
						<thead>
						<tr>
							<th>Tag</th>
							<th class='text-center'>Translations</th>
							<th class='text-center'>Fixed</th>
							<th class='text-center'>Floating</th>
							<th></th>
						</tr>
						</thead>
						<tbody>
						{% for tag in tags %}
							{% set translatedCount = tag.category.translations|length %}
							{% set totalLangs = languages|length %}
							{% set displayName = tag.category.nameFor('pl') ?? tag.category.slug %}
							{% set isFallback = tag.category.nameFor('pl') is null %}
							<tr>
								<td>
								<span class='chip' title='Slug: {{ tag.category.slug }}'>
									<span class='chip-body'>
										<span class='chip-label{{ isFallback ? ' chip-label-fallback' : '' }}'>{{ displayName }}</span>
									</span>
								</span>
								</td>
								<td class='text-center'
								    title='{{ translatedCount }} of {{ totalLangs }} languages translated'>
									<button
											type='button'
											class='btn btn-sm btn-outline-light tag-translate-btn'
											data-bs-toggle='modal'
											data-bs-target='#tag-modal-{{ tag.category.id }}'
											title='Edit translations'
									>
										<i class='bi bi-translate'></i> {{ translatedCount }}/{{ totalLangs }}
									</button>
								</td>
								<td class='text-center' title='Fixed holidays'>
									<i class='bi bi-calendar-event'></i> {{ tag.fixedCount }}
								</td>
								<td class='text-center' title='Floating holidays'>
									<i class='bi bi-calendar-range'></i> {{ tag.floatingCount }}
								</td>
								<td class='text-end'>
									<form
											method='post'
											action='{{ path('admin_tags_delete', {id: tag.category.id}) }}'
											class='chip-delete-form'
											data-confirm='Delete tag "{{ tag.category.slug }}"? It is used by {{ tag.fixedCount }} fixed and {{ tag.floatingCount }} floating holiday(s). Holidays will keep their other tags.'
									>
										<button type='submit' class='btn btn-sm btn-outline-danger tag-delete-btn'
										        title='Delete tag' aria-label='Delete tag'>
											<i class='bi bi-trash'></i>
										</button>
									</form>
								</td>
							</tr>
						{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}

			{% for tag in tags %}
				<div class='modal fade' id='tag-modal-{{ tag.category.id }}' tabindex='-1' aria-hidden='true'>
					<div class='modal-dialog modal-dialog-centered'>
						<div class='modal-content'>
							<form method='post'
							      action='{{ path('admin_tags_translations_save', {id: tag.category.id}) }}'>
								<div class='modal-header'>
									<h5 class='modal-title'>
										<i class='bi bi-tag'></i>
										<span class='text-monospace'>{{ tag.category.slug }}</span>
									</h5>
									<button type='button' class='btn-close' data-bs-dismiss='modal'
									        aria-label='Close'></button>
								</div>
								<div class='modal-body'>
									<p class='form-label mb-3'>Translations</p>
									<div class='translation-grid'>
										{% for language in languages %}
											<label class='translation-row'>
												<span class='translation-lang'
												      title='{{ language.name }}'>{{ language.code|upper }}</span>
												<input
														type='text'
														name='names[{{ language.code }}]'
														class='form-control manage-input'
														value='{{ tag.category.nameFor(language.code) ?? '' }}'
														placeholder='— untranslated —'
														maxlength='127'
												>
											</label>
										{% endfor %}
									</div>
									<p class='translation-hint mt-3'>Leave a field empty to remove that translation.</p>
								</div>
								<div class='modal-footer'>
									<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal'>Cancel
									</button>
									<button type='submit' class='btn btn-primary'>
										<i class='bi bi-check-lg'></i> Save
									</button>
								</div>
							</form>
						</div>
					</div>
				</div>
			{% endfor %}
		</div>
	</main>

	<script>
		document.querySelectorAll('.chip-delete-form').forEach(form =>
			form.addEventListener('submit', e => {
				if (!window.confirm(form.dataset.confirm)) {
					e.preventDefault();
				}
			}));
	</script>
{% endblock %}
