{% extends 'base.html.twig' %}
{% block title %}Missing {{ kind }} translations - Ferrio Admin{% endblock %}
{% block body %}
	<main class='section-manage-main' data-page='admin-missing-overview'>
		{% include 'components/sidebar.html.twig' %}
		{% set page_title %}Missing {{ kind }} translations{% endset %}
		{% include 'components/topbar.html.twig' with {pageTitle: page_title} %}
		<div class='manage-content'>
			<p class='text-muted mb-3'>{{ kindTotal }} Polish {{ kind }} holiday(s) in total. Click a language to see exactly which ones are missing a translation.</p>
			<div class='table-responsive'>
				<table class='table table-dark table-striped table-hover align-middle'>
					<thead>
					<tr>
						<th scope='col'>Code</th>
						<th scope='col'>Language</th>
						<th scope='col' class='text-end'>Translated</th>
						<th scope='col' class='text-end'>Missing</th>
					</tr>
					</thead>
					<tbody>
					{% for row in rows %}
						{% set isComplete = row.missing == 0 %}
						<tr class='tr-holiday {{ isComplete ? '' : 'tr-holiday-clickable' }}'
							{% if not isComplete %}
								role='button' tabindex='0'
								data-href='{{ path('admin_missing', {kind: kind, lang: row.language.code}) }}'
							{% endif %}>
							<th scope='row'>{{ row.language.code }}</th>
							<td>{{ row.language.name }}</td>
							<td class='text-end'>{{ row.translated }} / {{ row.total }}</td>
							<td class='text-end'>
								{% if isComplete %}
									<span class='badge translation-count-chip-full'>0</span>
								{% else %}
									<span class='badge translation-count-chip-empty'>{{ row.missing }}</span>
								{% endif %}
							</td>
						</tr>
					{% else %}
						<tr>
							<td colspan='4' class='text-center text-muted py-4'>No target languages configured.</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</main>
{% endblock %}
