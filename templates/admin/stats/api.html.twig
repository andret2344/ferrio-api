{% extends 'base.html.twig' %}
{% block title %}API traffic — Ferrio Admin{% endblock %}
{% block body %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'API traffic'} %}
		<div class='manage-content'>

			<form method='get' class='mb-4 d-flex gap-2 flex-wrap' data-stats-form>
				<select name='group' class='form-select manage-input' style='width: auto'>
					{% for option in groupings %}
						<option value='{{ option }}' {{ option == grouping ? 'selected' : '' }}>
							By {{ option }}
						</option>
					{% endfor %}
				</select>
				<select name='days' class='form-select manage-input' style='width: auto'>
					{% for range in ranges %}
						<option value='{{ range }}' {{ range == days ? 'selected' : '' }}>
							{{ range == 0 ? 'All time' : 'Last ' ~ range ~ ' day' ~ (range == 1 ? '' : 's') }}
						</option>
					{% endfor %}
				</select>
				<noscript>
					<button type='submit' class='btn btn-primary'>Apply</button>
				</noscript>
			</form>

			{% if stats.total == 0 %}
				<p class='text-muted'>No API hits recorded in this range.</p>
			{% else %}
				<div class='dashboard-grid'>
					{% for version in stats.versions %}
						<div class='dashboard-stat'>
							<div class='dashboard-stat-icon'><i class='bi bi-braces'></i></div>
							<div class='dashboard-stat-body'>
								<div class='dashboard-stat-label'>{{ version }}</div>
								<div class='dashboard-stat-value'>{{ stats.version_totals[version] | number_format(0, '.', ' ') }}</div>
							</div>
						</div>
					{% endfor %}
					<div class='dashboard-stat'>
						<div class='dashboard-stat-icon'><i class='bi bi-graph-up'></i></div>
						<div class='dashboard-stat-body'>
							<div class='dashboard-stat-label'>Total hits</div>
							<div class='dashboard-stat-value'>{{ stats.total | number_format(0, '.', ' ') }}</div>
						</div>
					</div>
				</div>

				<div class='chart-grid'>
					{% include 'admin/components/chart_card.html.twig' with {
						id: 'traffic',
						title: 'Hits per ' ~ grouping,
						note: 'One line per API version',
						spec: traffic_chart,
					} only %}
					{% include 'admin/components/chart_card.html.twig' with {
						id: 'endpoints',
						title: 'Top endpoints',
						note: 'Numeric path segments are folded together',
						spec: endpoint_chart,
						tall: true,
					} only %}
				</div>

				<div class='chart-grid'>
					{% for chart in version_charts %}
						{% include 'admin/components/chart_card.html.twig' with {
							id: 'endpoints-' ~ chart.version,
							title: chart.version ~ ' endpoints',
							note: 'Share of ' ~ chart.version ~ ' traffic; hit counts are in the legend',
							spec: chart.spec,
							tall: true,
						} only %}
					{% endfor %}
				</div>
			{% endif %}
		</div>
	</main>

	<script>
		document.querySelectorAll('[data-stats-form] select').forEach(select =>
			select.addEventListener('change', () => select.form.submit()));
	</script>
{% endblock %}
