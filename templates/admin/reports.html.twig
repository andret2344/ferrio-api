											class='report-row'
											role='button'
											tabindex='0'
											{{ _self.suggestion_row_attrs(s, 'floating_suggestion', fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) }}
									>
										<td>{{ loop.index }}</td>
										<td>{{ s.name }}</td>
										<td>{{ s.date }}</td>
										<td class='description-cell'>
											<span class='description-text'>{{ s.description }}</span>
										</td>
										<td>{{ s.country ? s.country.isoCode : '-' }}</td>
										<td>
											<span class='state-cell'>
												<span class='badge report-state report-state-{{ s.reportState.value|lower }}'
												      data-role='state-badge'>
													{{ s.reportState.value }}
												</span>
												<button
														type='button'
														class='btn btn-comment-icon {{ s.comment ? '' : 'd-none' }}'
														data-role='comment-popover'
														data-bs-toggle='popover'
														data-bs-trigger='focus'
														data-bs-placement='top'
														data-bs-title='Comment'
														data-bs-content='{{ s.comment ?? '' }}'
														tabindex='0'
														title='Show comment'>
													<i class='bi bi-chat-left-text-fill'></i>
												</button>
											</span>
										</td>
										<td>{{ s.datetime|date('Y-m-d H:i') }}</td>
										<td class='user-cell'>
											{% set u = users[s.userId] ?? null %}
											{% if u and (u.name or u.email) %}
												<div class='user-name'>{{ u.name ?? '-' }}</div>
												<div class='user-email'>{{ u.email ?? '-' }}</div>
											{% endif %}
											<div class='user-uid'>{{ s.userId }}</div>
										</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

				{# Fixed Errors #}
				<div class='tab-pane fade' id='fixed-errors'>
					<div class='report-count'>{{ fixedErrors|length }} {{ fixedErrors|length == 1 ? 'entry' : 'entries' }}</div>
					{% if fixedErrors is empty %}
						<div class='text-center text-muted py-5'>No fixed holiday error reports.</div>
					{% else %}
						<div class='table-responsive'>
							<table class='table table-dark table-striped table-hover align-middle'>
								<thead>
								<tr>
									<th>#</th>
									<th>Type</th>
									<th>Description</th>
									<th>State</th>
									<th>Reported</th>
									<th>User</th>
								</tr>
								</thead>
								<tbody>
								{% for e in fixedErrors %}
									<tr
											class='report-row'
											role='button'
											tabindex='0'
											{{ _self.error_row_attrs(e, 'fixed_error', fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) }}
									>
										<td>{{ loop.index }}</td>
										<td>
											<span class='badge bg-light text-dark'>{{ e.reportType.value|lower|replace({'_': ' '})|capitalize }}</span>
										</td>
										{% if e.description %}
											<td class='description-cell'>
												<span class='description-text'>{{ e.description }}</span>
											</td>
										{% else %}
											<td>-</td>
										{% endif %}
										<td>
											<span class='state-cell'>
												<span class='badge report-state report-state-{{ e.reportState.value|lower }}'
												      data-role='state-badge'>
													{{ e.reportState.value }}
												</span>
												<button
														type='button'
														class='btn btn-comment-icon {{ e.comment ? '' : 'd-none' }}'
														data-role='comment-popover'
														data-bs-toggle='popover'
														data-bs-trigger='focus'
														data-bs-placement='top'
														data-bs-title='Comment'
														data-bs-content='{{ e.comment ?? '' }}'
														tabindex='0'
														title='Show comment'>
													<i class='bi bi-chat-left-text-fill'></i>
												</button>
											</span>
										</td>
										<td>{{ e.datetime|date('Y-m-d H:i') }}</td>
										<td class='user-cell'>
											{% set u = users[e.userId] ?? null %}
											{% if u and (u.name or u.email) %}
												<div class='user-name'>{{ u.name ?? '-' }}</div>
												<div class='user-email'>{{ u.email ?? '-' }}</div>
											{% endif %}
											<div class='user-uid'>{{ e.userId }}</div>
										</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

				{# Floating Errors #}
				<div class='tab-pane fade' id='floating-errors'>
					<div class='report-count'>{{ floatingErrors|length }} {{ floatingErrors|length == 1 ? 'entry' : 'entries' }}</div>
					{% if floatingErrors is empty %}
						<div class='text-center text-muted py-5'>No floating holiday error reports.</div>
					{% else %}
						<div class='table-responsive'>
							<table class='table table-dark table-striped table-hover align-middle'>
								<thead>
								<tr>
									<th>#</th>
									<th>Type</th>
									<th>Description</th>
									<th>State</th>
									<th>Reported</th>
									<th>User</th>
								</tr>
								</thead>
								<tbody>
								{% for e in floatingErrors %}
									<tr
											class='report-row'
											role='button'
											tabindex='0'
											{{ _self.error_row_attrs(e, 'floating_error', fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) }}
									>
										<td>{{ loop.index }}</td>
										<td>
											<span class='badge bg-light text-dark'>{{ e.reportType.value|lower|replace({'_': ' '})|capitalize }}</span>
										</td>
										{% if e.description %}
											<td class='description-cell'>
												<span class='description-text'>{{ e.description }}</span>
											</td>
										{% else %}
											<td>-</td>
										{% endif %}
										<td>
											<span class='state-cell'>
												<span class='badge report-state report-state-{{ e.reportState.value|lower }}'
												      data-role='state-badge'>
													{{ e.reportState.value }}
												</span>
												<button
														type='button'
														class='btn btn-comment-icon {{ e.comment ? '' : 'd-none' }}'
														data-role='comment-popover'
														data-bs-toggle='popover'
														data-bs-trigger='focus'
														data-bs-placement='top'
														data-bs-title='Comment'
														data-bs-content='{{ e.comment ?? '' }}'
														tabindex='0'
														title='Show comment'>
													<i class='bi bi-chat-left-text-fill'></i>
												</button>
											</span>
										</td>
										<td>{{ e.datetime|date('Y-m-d H:i') }}</td>
										<td class='user-cell'>
											{% set u = users[e.userId] ?? null %}
											{% if u and (u.name or u.email) %}
												<div class='user-name'>{{ u.name ?? '-' }}</div>
