{% extends 'base.html.twig' %}

{% block title %}{{ label }} - Ferrio Admin{% endblock %}

{% block body %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: label} %}
		<div class='manage-content'>
			<form class='reports-toolbar' method='get' action='{{ path('admin_reports', {type: type}) }}'>
				<div class='reports-filters'>
					<label class='filter-inline'>
						<span class='filter-inline-label'>Platform</span>
						<select name='platform' class='form-select form-select-sm' onchange='this.form.submit()'>
							<option value=''>All</option>
							{% for p in platforms %}
								<option value='{{ p }}' {{ filters.platform == p ? 'selected' : '' }}>{{ p|capitalize }}</option>
							{% endfor %}
						</select>
					</label>

					<label class='filter-inline'>
						<span class='filter-inline-label'>State</span>
						<select name='state' class='form-select form-select-sm' onchange='this.form.submit()'>
							<option value=''>All</option>
							{% for s in report_states %}
								<option value='{{ s }}' {{ filters.state == s ? 'selected' : '' }}>{{ s }}</option>
							{% endfor %}
						</select>
					</label>

					<label class='filter-inline'>
						<span class='filter-inline-label'>Country</span>
						<select name='device_country' class='form-select form-select-sm' onchange='this.form.submit()'>
							<option value=''>All</option>
							<option value='unknown' {{ filters.device_country == 'unknown' ? 'selected' : '' }}>
								Unknown
							</option>
							{% for c in device_countries %}
								<option value='{{ c }}' {{ filters.device_country == c ? 'selected' : '' }}>{{ c }}</option>
							{% endfor %}
						</select>
					</label>
				</div>
			</form>
			<div class='reports-pane' id='{{ type }}'>
				{% include 'admin/components/reports_table.html.twig' with {
					kind: kind,
					rows: rows,
					emptyLabel: emptyLabel,
					users: users,
					bans: bans,
					defaultLang: defaultLang,
					fixedHolidays: fixedHolidays,
					floatingHolidays: floatingHolidays,
				} only %}
			</div>
		</div>
	</main>

	{# Ban / unban / copy-uid actions of the reporter bar. `prefix` matches the ids the frontend
	   populates for the given modal ('suggestionReport' or 'errorReport'). #}
	{% macro user_actions(prefix) %}
		<div class='report-user-actions'>
			<span class='badge ban-badge d-none' id='{{ prefix }}BanBadge'>
				<i class='bi bi-slash-circle'></i> Banned
			</span>
			<button type='button' class='btn btn-sm btn-outline-danger report-user-ban' id='{{ prefix }}BanBtn'
			        data-role='ban-open' data-user-id='' title='Ban user'>
				<i class='bi bi-slash-circle'></i> Ban
			</button>
			<button type='button' class='btn btn-sm btn-outline-light report-user-ban d-none' id='{{ prefix }}UnbanBtn'
			        data-role='unban-open' data-user-id='' title='Unban user'>
				<i class='bi bi-check-lg'></i> Unban
			</button>
			<button type='button' class='user-id-copy' id='{{ prefix }}UserId' title='Copy user ID'>
				<i class='bi bi-clipboard'></i>
			</button>
		</div>
	{% endmacro %}

	{% macro state_dropdown(toggleId, hiddenId, report_states) %}
		<div class='dropdown state-dropdown'>
			<button
					class='btn dropdown-toggle state-dropdown-toggle'
					type='button'
					id='{{ toggleId }}'
					data-bs-toggle='dropdown'
					aria-expanded='false'>
				<span class='badge report-state' data-role='state-toggle-badge'></span>
			</button>
			<ul class='dropdown-menu dropdown-menu-dark state-dropdown-menu'
			    aria-labelledby='{{ toggleId }}'>
				{% for state in report_states %}
					<li>
						<button type='button' class='dropdown-item' data-value='{{ state }}'>
							<span class='badge report-state report-state-{{ state|lower }}'>{{ state }}</span>
						</button>
					</li>
				{% endfor %}
			</ul>
			<input type='hidden' id='{{ hiddenId }}' name='report_state'>
		</div>
	{% endmacro %}

	{% if not isError %}
		<div class='modal fade' id='moderateSuggestionModal' tabindex='-1'
		     aria-labelledby='moderateSuggestionModalLabel' aria-hidden='true'
		     data-moderate-url='{{ path('admin_reports_moderate') }}'
		     data-delete-url='{{ path('admin_reports_delete') }}'>
			<div class='modal-dialog modal-dialog-centered modal-lg'>
				<div class='modal-content'>
					<div class='modal-header'>
						<div class='modal-heading-group'>
							<h5 class='modal-title' id='moderateSuggestionModalLabel'>
								<i class='bi bi-lightbulb me-2'></i>Moderate suggestion
							</h5>
							<div class='modal-subtitle'>
								<i class='bi bi-clock-history'></i>
								<span id='suggestionReportDatetime'></span>
							</div>
						</div>
						<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
					</div>
					<div class='modal-body'>
						<div class='report-device-bar' id='suggestionReportPills'></div>
						<div class='report-user-card mb-3'>
							<span class='report-user-avatar' id='suggestionReportAvatar'>
								<img alt='' class='report-user-avatar-img d-none'>
								<i class='bi bi-person-circle'></i>
							</span>
							<div class='report-user-main'>
								<span class='report-user-name' id='suggestionReportUser'></span>
								<span class='report-user-role' id='suggestionReportRole'>Reporter</span>
							</div>
							{{ _self.user_actions('suggestionReport') }}
						</div>
						<div class='report-content-card mb-3'>
							<div class='report-content-title' id='suggestionReportName'></div>
							<div class='report-content-submeta'>
								<span class='report-content-submeta-item'>
									<i class='bi bi-calendar2-event'></i>
									<span id='suggestionReportDate'></span>
								</span>
								<span class='report-content-submeta-item'>
									<i class='bi bi-geo-alt'></i>
									<span id='suggestionReportCountry'></span>
								</span>
							</div>
							<div class='report-content-body report-content-description' id='suggestionReportDescription'></div>
						</div>
						<form id='suggestionForm'>
							<input type='hidden' id='suggestionKind'>
							<input type='hidden' id='suggestionId'>
							<div class='mb-3'>
								<label class='form-label' for='suggestionStateToggle'>State</label>
								{{ _self.state_dropdown('suggestionStateToggle', 'suggestionState', report_states) }}
							</div>
							<div class='mb-3'>
								<label for='suggestionHolidayId' class='form-label'>Linked holiday ID</label>
								<input type='number' class='form-control' id='suggestionHolidayId' min='1'
								       placeholder='Leave empty to clear'>
								<div class='form-text'>Link this suggestion to an existing holiday (optional).</div>
							</div>
							<div class='mb-3'>
								<label for='suggestionComment' class='form-label'>Comment</label>
								<textarea class='form-control' id='suggestionComment' rows='4'
								          placeholder='Optional note (e.g. "duplicate of #42")'></textarea>
							</div>
							<div class='alert alert-danger d-none' id='suggestionError' role='alert'></div>
						</form>
					</div>
					<div class='modal-footer'>
						<button type='button' class='btn btn-danger me-auto' id='suggestionDelete'>
							<i class='bi bi-trash me-1'></i>Delete
						</button>
						<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal'>Cancel</button>
						<button type='button' class='btn btn-primary' id='suggestionSave'>
							<i class='bi bi-check-lg me-1'></i>Save
						</button>
					</div>
				</div>
			</div>
		</div>
	{% endif %}

	{% if isError %}
		<div class='modal fade' id='moderateErrorModal' tabindex='-1'
		     aria-labelledby='moderateErrorModalLabel' aria-hidden='true'
		     data-moderate-url='{{ path('admin_reports_moderate') }}'
		     data-delete-url='{{ path('admin_reports_delete') }}'>
			<div class='modal-dialog modal-dialog-centered modal-lg'>
				<div class='modal-content'>
					<div class='modal-header'>
						<div class='modal-heading-group'>
							<h5 class='modal-title' id='moderateErrorModalLabel'>
								<i class='bi bi-exclamation-triangle me-2'></i>Moderate error report
							</h5>
							<div class='modal-subtitle'>
								<i class='bi bi-clock-history'></i>
								<span id='errorReportDatetime'></span>
							</div>
						</div>
						<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
					</div>
					<div class='modal-body'>
						<div class='report-device-bar' id='errorReportPills'></div>
						<div class='report-user-card mb-3'>
							<span class='report-user-avatar' id='errorReportAvatar'>
								<img alt='' class='report-user-avatar-img d-none'>
								<i class='bi bi-person-circle'></i>
							</span>
							<div class='report-user-main'>
								<span class='report-user-name' id='errorReportUser'></span>
								<span class='report-user-role' id='errorReportRole'>Reporter</span>
							</div>
							{{ _self.user_actions('errorReport') }}
						</div>
						<div class='referred-holiday-card mb-3' id='referredHolidayCard'>
							<div class='referred-holiday-label'>
								<i class='bi bi-link-45deg'></i>
								Referred holiday
							</div>
							<div class='referred-holiday-content' id='referredHolidayContent' tabindex='0'>
								<div class='referred-holiday-icon'>
									<i class='bi bi-calendar2-event'></i>
								</div>
								<div class='referred-holiday-body'>
									<div class='referred-holiday-name-row'>
										<span class='referred-holiday-name' id='referredHolidayName'></span>
										<span class='referred-holiday-lang' id='referredHolidayLang'></span>
									</div>
									<div class='referred-holiday-description' id='referredHolidayDescription'></div>
								</div>
							</div>
							<div class='referred-holiday-empty d-none' id='referredHolidayEmpty'>
								<i class='bi bi-calendar2-x'></i>
								<span>No referred holiday.</span>
							</div>
						</div>
						<div class='report-content-card mb-3'>
							<div class='report-content-title' id='errorReportType'></div>
							<div class='report-content-body report-content-description' id='errorReportDescription'></div>
						</div>
						<form id='errorForm'>
							<input type='hidden' id='errorKind'>
							<input type='hidden' id='errorId'>
							<div class='mb-3'>
								<label class='form-label' for='errorStateToggle'>State</label>
								{{ _self.state_dropdown('errorStateToggle', 'errorState', report_states) }}
							</div>
							<div class='mb-3'>
								<label for='errorComment' class='form-label'>Comment</label>
								<textarea class='form-control' id='errorComment' rows='4'
								          placeholder='Optional note (e.g. "duplicate of #42")'></textarea>
							</div>
							<div class='alert alert-danger d-none' id='errorError' role='alert'></div>
						</form>
					</div>
					<div class='modal-footer'>
						<button type='button' class='btn btn-danger me-auto' id='errorDelete'>
							<i class='bi bi-trash me-1'></i>Delete
						</button>
						<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal'>Cancel</button>
						<button type='button' class='btn btn-primary' id='errorSave'>
							<i class='bi bi-check-lg me-1'></i>Save
						</button>
					</div>
				</div>
			</div>
		</div>
	{% endif %}

	<div class='modal fade' id='reportDeleteConfirmModal' tabindex='-1'
	     aria-labelledby='reportDeleteConfirmModalLabel' aria-hidden='true'>
		<div class='modal-dialog modal-dialog-centered'>
			<div class='modal-content'>
				<div class='modal-header'>
					<h5 class='modal-title' id='reportDeleteConfirmModalLabel'>
						<i class='bi bi-exclamation-triangle me-2'></i>Delete report?
					</h5>
					<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
				</div>
				<div class='modal-body'>
					This will permanently remove the report. This action cannot be undone.
				</div>
				<div class='modal-footer'>
					<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal'>No</button>
					<button type='button' class='btn btn-danger' id='reportDeleteConfirm'>
						<i class='bi bi-trash me-1'></i>Yes, delete
					</button>
				</div>
			</div>
		</div>
	</div>

	{% include 'admin/components/ban_modal.html.twig' %}
{% endblock %}
