{% extends 'base.html.twig' %}

{% macro suggestion_row_attrs(s, kind, fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) %}
	{% set linkedId = s.holiday ? s.holiday.id : null %}
	{% set referredName = s.name %}
	{% set referredDescription = s.description %}
	{% set canEdit = (kind == 'fixed_suggestion') and linkedId is not null and (fixedHolidaysPl[linkedId] ?? null) is not null %}
	{% set editPayload = null %}
	{% if canEdit %}
		{% set ph = fixedHolidaysPl[linkedId] %}
		{% set pm = fixedMetadataInfo[linkedId] %}
		{% set editPayload = {
			id: linkedId,
			name: ph.name,
			description: ph.description,
			day: pm.day,
			month: pm.month,
			country: pm.country,
			mature: pm.mature,
			tags: tagsByFixedMetadata[linkedId] ?? [],
		} %}
	{% endif %}
	data-kind='{{ kind }}'
	data-id='{{ s.id }}'
	data-state='{{ s.reportState.value }}'
	data-comment='{{ (s.comment ?? '')|e('html_attr') }}'
	data-holiday-id='{{ linkedId ?? '' }}'
	data-referred-name='{{ referredName|e('html_attr') }}'
	data-referred-description='{{ (referredDescription ?? '')|e('html_attr') }}'
	data-can-edit='{{ canEdit ? '1' : '0' }}'
	{% if editPayload %}data-edit-payload='{{ editPayload|json_encode|e('html_attr') }}'{% endif %}
{% endmacro %}

{% macro error_row_attrs(e, kind, fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) %}
	{% set linkedId = e.metadata ? e.metadata.id : null %}
	{% set isFixed = kind == 'fixed_error' %}
	{% set plData = isFixed ? (fixedHolidaysPl[linkedId] ?? null) : (floatingHolidaysPl[linkedId] ?? null) %}
	{% set referredName = plData ? plData.name : null %}
	{% set referredDescription = plData ? plData.description : null %}
	{% set canEdit = isFixed and e.language.code == 'pl' and linkedId is not null and plData is not null %}
	{% set editPayload = null %}
	{% if canEdit %}
		{% set pm = fixedMetadataInfo[linkedId] %}
		{% set editPayload = {
			id: linkedId,
			name: plData.name,
			description: plData.description,
			day: pm.day,
			month: pm.month,
			country: pm.country,
			mature: pm.mature,
			tags: tagsByFixedMetadata[linkedId] ?? [],
		} %}
	{% endif %}
	data-kind='{{ kind }}'
	data-id='{{ e.id }}'
	data-state='{{ e.reportState.value }}'
	data-comment='{{ (e.comment ?? '')|e('html_attr') }}'
	data-holiday-id='{{ linkedId ?? '' }}'
	data-referred-name='{{ (referredName ?? '')|e('html_attr') }}'
	data-referred-description='{{ (referredDescription ?? '')|e('html_attr') }}'
	data-can-edit='{{ canEdit ? '1' : '0' }}'
	{% if editPayload %}data-edit-payload='{{ editPayload|json_encode|e('html_attr') }}'{% endif %}
{% endmacro %}

{% block body %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Reports'} %}
		<div class='manage-content'>
			<h2 class='manage-page-title'>User Reports</h2>

			<ul class='nav nav-tabs reports-tabs' id='reportsTabs'>
				<li class='nav-item'>
					<button
							class='nav-link active'
							id='fixed-suggestions-tab'
							data-bs-toggle='tab'
							data-bs-target='#fixed-suggestions'
							type='button'
					>Fixed Suggestions
						<span class='badge bg-secondary ms-1'>{{ fixedSuggestions|length }}</span>
					</button>
				</li>
				<li class='nav-item'>
					<button
							class='nav-link'
							id='floating-suggestions-tab'
							data-bs-toggle='tab'
							data-bs-target='#floating-suggestions'
							type='button'
					>Floating Suggestions
						<span class='badge bg-secondary ms-1'>{{ floatingSuggestions|length }}</span>
					</button>
				</li>
				<li class='nav-item'>
					<button
							class='nav-link'
							id='fixed-errors-tab'
							data-bs-toggle='tab'
							data-bs-target='#fixed-errors'
							type='button'
					>Fixed Errors
						<span class='badge bg-secondary ms-1'>{{ fixedErrors|length }}</span>
					</button>
				</li>
				<li class='nav-item'>
					<button
							class='nav-link'
							id='floating-errors-tab'
							data-bs-toggle='tab'
							data-bs-target='#floating-errors'
							type='button'
					>Floating Errors
						<span class='badge bg-secondary ms-1'>{{ floatingErrors|length }}</span>
					</button>
				</li>
			</ul>

			<div class='tab-content mt-3' id='reportsTabContent'>
				{# Fixed Suggestions #}
				<div class='tab-pane fade show active' id='fixed-suggestions'>
					<div class='report-count'>{{ fixedSuggestions|length }} {{ fixedSuggestions|length == 1 ? 'entry' : 'entries' }}</div>
					{% if fixedSuggestions is empty %}
						<div class='text-center text-muted py-5'>No fixed holiday suggestions.</div>
					{% else %}
						<div class='table-responsive'>
							<table class='table table-dark table-striped table-hover align-middle'>
								<thead>
								<tr>
									<th>#</th>
									<th>Name</th>
									<th>Date</th>
									<th>Description</th>
									<th>Country</th>
									<th>State</th>
									<th>Reported</th>
									<th>User</th>
								</tr>
								</thead>
								<tbody>
								{% for s in fixedSuggestions %}
									<tr
											class='report-row'
											role='button'
											tabindex='0'
											{{ _self.suggestion_row_attrs(s, 'fixed_suggestion', fixedHolidaysPl, floatingHolidaysPl, fixedMetadataInfo, tagsByFixedMetadata) }}
									>
										<td>{{ loop.index }}</td>
										<td>{{ s.name }}</td>
										<td>{{ '%02d.%02d'|format(s.day, s.month) }}</td>
										<td class='description-cell'>
											<span class='description-text'>{{ s.description }}</span>
										</td>
										<td>{{ s.country ? s.country.isoCode : '-' }}</td>
										<td>
											<span class='state-cell'>
												<span class='badge report-state report-state-{{ s.reportState.value|lower }}'
												      data-role='state-badge'>
													{{ s.reportState.value }}
												</span>
												<button type='button'
												        class='btn btn-comment-icon {{ s.comment ? '' : 'd-none' }}'
												        data-role='comment-popover'
												        data-bs-toggle='popover'
												        data-bs-trigger='focus'
												        data-bs-placement='top'
												        data-bs-title='Comment'
												        data-bs-content='{{ s.comment ?? '' }}'
												        tabindex='0'
												        title='Show comment'>
													<i class='bi bi-chat-left-text-fill'></i>
												</button>
											</span>
										</td>
										<td>{{ s.datetime|date('Y-m-d H:i') }}</td>
										<td class='user-cell'>
											{% set u = users[s.userId] ?? null %}
											{% if u and (u.name or u.email) %}
												<div class='user-name'>{{ u.name ?? '-' }}</div>
												<div class='user-email'>{{ u.email ?? '-' }}</div>
											{% endif %}
											<div class='user-uid'>{{ s.userId }}</div>
										</td>
									</tr>
								{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>

				{# Floating Suggestions #}
				<div class='tab-pane fade' id='floating-suggestions'>
					<div class='report-count'>{{ floatingSuggestions|length }} {{ floatingSuggestions|length == 1 ? 'entry' : 'entries' }}</div>
					{% if floatingSuggestions is empty %}
