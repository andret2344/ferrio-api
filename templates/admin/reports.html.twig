								{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</main>

	<div class='modal fade' id='moderateModal' tabindex='-1' aria-labelledby='moderateModalLabel' aria-hidden='true'
	     data-moderate-url='{{ path('admin_reports_moderate') }}'
	     data-delete-url='{{ path('admin_reports_delete') }}'>
		<div class='modal-dialog modal-dialog-centered modal-lg'>
			<div class='modal-content'>
				<div class='modal-header'>
					<h5 class='modal-title' id='moderateModalLabel'>Moderate report</h5>
					<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
				</div>
				<div class='modal-body'>
					<div class='referred-holiday-card mb-3' id='referredHolidayCard'>
						<div class='referred-holiday-label text-muted small mb-1'>Referred holiday</div>
						<div class='referred-holiday-content' id='referredHolidayContent' tabindex='0'>
							<div class='referred-holiday-name fw-semibold' id='referredHolidayName'></div>
							<div class='referred-holiday-description' id='referredHolidayDescription'></div>
							<div class='referred-holiday-empty text-muted fst-italic d-none'
							     id='referredHolidayEmpty'>No referred holiday.</div>
							<div class='referred-holiday-edit-hint text-muted small mt-1 d-none'
							     id='referredHolidayEditHint'>
								<i class='bi bi-pencil-square'></i> Click to edit
							</div>
						</div>
					</div>
					<form id='moderateForm'>
						<input type='hidden' name='kind' id='moderateKind'>
						<input type='hidden' name='id' id='moderateId'>
						<div class='mb-3'>
							<label class='form-label' for='moderateStateToggle'>State</label>
							<div class='dropdown state-dropdown'>
								<button
										class='btn dropdown-toggle state-dropdown-toggle'
										type='button'
										id='moderateStateToggle'
										data-bs-toggle='dropdown'
										aria-expanded='false'>
									<span class='badge report-state' data-role='state-toggle-badge'></span>
								</button>
								<ul class='dropdown-menu dropdown-menu-dark state-dropdown-menu'
								    aria-labelledby='moderateStateToggle'>
									{% for state in report_states %}
										<li>
											<button type='button' class='dropdown-item' data-value='{{ state }}'>
												<span class='badge report-state report-state-{{ state|lower }}'>{{ state }}</span>
											</button>
										</li>
									{% endfor %}
								</ul>
								<input type='hidden' id='moderateState' name='report_state'>
							</div>
						</div>
						<div class='mb-3'>
							<label for='moderateHolidayId' class='form-label'>Linked Holiday ID</label>
							<input type='number' class='form-control' id='moderateHolidayId' name='holiday_id' min='1'
							       placeholder='Leave empty to clear'>
						</div>
						<div class='mb-3'>
							<label for='moderateComment' class='form-label'>Comment</label>
							<textarea class='form-control' id='moderateComment' name='comment' rows='4'
							          placeholder='Optional note (e.g. "duplicate of #42")'></textarea>
						</div>
						<div class='alert alert-danger d-none' id='moderateError' role='alert'></div>
					</form>
				</div>
				<div class='modal-footer'>
					<button type='button' class='btn btn-danger me-auto' id='moderateDelete'>
						<i class='bi bi-trash me-1'></i>Delete
					</button>
					<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal'>Cancel</button>
					<button type='button' class='btn btn-primary' id='moderateSave'>
						<i class='bi bi-check-lg me-1'></i>Save
					</button>
				</div>
			</div>
		</div>
	</div>

	{% include 'admin/components/holiday_edit_modal.html.twig' with {countries: countries, tags: tags} %}

{% endblock %}
