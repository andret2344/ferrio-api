{% extends 'base.html.twig' %}
{% block title %}Floating Holidays — Ferrio Admin{% endblock %}
{% block body %}
	<main class='section-manage-main' data-page='admin-floating'>
		{% include 'components/sidebar.html.twig' %}
		{% set toolbar_html %}
			<a href='{{ path('admin_holiday_new', {kind: 'floating'}) }}' class='btn btn-sm btn-primary'>
				<i class='bi bi-plus-lg me-1'></i>Add holiday
			</a>
		{% endset %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Floating Holidays', toolbar: toolbar_html} %}
		<div class='manage-content'>
			<div class='table-responsive'>
				<table class='table table-dark table-striped table-hover align-middle'>
					<thead>
					<tr>
						<th scope='col'>#</th>
						<th scope='col'>Country</th>
						<th scope='col'>+18</th>
						<th scope='col'>Algorithm</th>
						<th scope='col'>Args</th>
						<th scope='col'>Name (PL)</th>
						<th scope='col'>Tags</th>
						<th scope='col'>Translations</th>
					</tr>
					</thead>
					<tbody>
					{% for holiday in floating_holidays %}
						{% set m = holiday.metadata %}
						<tr class='tr-holiday tr-holiday-clickable' role='button' tabindex='0'
						    data-href='{{ path('admin_holiday_detail', {kind: 'floating', id: m.id}) }}'>
							<th scope='row'>{{ m.id }}</th>
							<td>
								{% if m.country %}
									{{ m.country.isoCode }} - {{ m.country.englishName }}
								{% else %}
									International
								{% endif %}
							</td>
							<td>{{ m.matureContent ? 'Yes' : 'No' }}</td>
							<td><code class='floating-algorithm'>{{ m.algorithm.value }}</code></td>
							<td>
								{% if m.algorithmArgs %}
									<code class='floating-args'>{{ m.algorithmArgs }}</code>
								{% else %}
									<span class='text-muted'>—</span>
								{% endif %}
							</td>
							<td>{{ holiday.name }}</td>
							<td>{{ tagCounts[m.id]|default(0) }}</td>
							<td>{% include 'admin/components/translation_count.html.twig' with {count: translationCounts[m.id]|default(0), total: targetLanguageCount} only %}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan='8' class='text-center text-muted py-4'>No floating holidays.</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</main>
{% endblock %}
