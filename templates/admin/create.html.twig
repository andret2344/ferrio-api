{% extends 'base.html.twig' %}
{% block body %}
	{% set toolbar_html %}
		<div class="form-check form-switch mb-0">
			<input
					class="form-check-input"
					type="checkbox"
					id="hideDescribedHolidays"
					aria-checked="false">
			<label class="form-check-label text-light" for="hideDescribedHolidays">Hide described</label>
		</div>
	{% endset %}
	<main class='section-manage-main' data-page='admin-create' data-current-month='{{ month }}'>
		{% include 'components/topbar.html.twig' with {toolbar: toolbar_html} %}
		<div class='manage-content'>
			<h2 class='manage-page-title'>Holidays</h2>
			<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
			<div class='table-responsive'>
				<table class="table table-dark table-striped table-hover align-middle">
					<caption>Translations</caption>
					<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col" style='min-width: 142px'>Country</th>
						<th scope="col">+18</th>
						<th scope="col">Month</th>
						<th scope="col">Day</th>
						<th scope="col" class='w-25'>Name</th>
						<th scope="col" class='w-75'>Description</th>
						<th scope="col">Action</th>
					</tr>
					</thead>
					<tbody>
					{% for element in fixed_holidays %}
						{% set tag_ids = tags_by_metadata[element.id] ?? [] %}
						<tr class='tr-holiday' data-row-id='{{ element.id }}'>
							<th scope="row">{{ element.id }}</th>
							<td data-role='country-cell' data-country='{{ element.countryCode ?? '' }}'>
								{% if element.countryName %}
									{{ element.countryCode }} - {{ element.countryName }}
								{% else %}
									International
								{% endif %}
							</td>
							<td data-role='mature-cell' data-mature='{{ element.matureContent ? '1' : '0' }}'>
								{{ element.matureContent ? 'Yes' : 'No' }}
							</td>
							<td data-role='month-cell'>{{ element.month }}</td>
							<td data-role='day-cell'>{{ element.day }}</td>
							<td data-role='name-cell'>{{ element.name }}</td>
							<td data-role='description-cell'
							    class='holiday-description'>{{ element.description|nl2br }}</td>
							<td>
								<button
										type='button'
										class='btn btn-sm btn-outline-light btn-edit-holiday'
										title='Edit'
										data-bs-toggle='modal'
										data-bs-target='#holidayEditModal'
										data-id='{{ element.id }}'
										data-name='{{ element.name|e('html_attr') }}'
										data-description='{{ element.description|default('')|e('html_attr') }}'
										data-month='{{ element.month }}'
										data-day='{{ element.day }}'
										data-country='{{ element.countryCode ?? '' }}'
										data-mature='{{ element.matureContent ? '1' : '0' }}'
										data-tags='{{ tag_ids|json_encode|e('html_attr') }}'
								><i class='bi bi-pencil-square'></i></button>
							</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
			<form id='create' method='post'>
				<input type='hidden' name='action' value='create' form='create'/>
				{{ form_widget(createForm._token) }}
			</form>
			<div class='table-responsive'>
				<table class='table table-dark table-striped table-hover align-middle'>
					<caption>Adding</caption>
					<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Country</th>
						<th scope="col">+18</th>
						<th scope="col">Month</th>
						<th scope="col">Day</th>
						<th scope="col" class='w-25'>Name</th>
						<th scope="col" class='w-75'>Description</th>
						<th scope="col">Action</th>
					</tr>
					</thead>
					<tbody>
					<tr>
						<th scope="row">#</th>
						<td>
							<label for='country-create' class='d-none'>Country</label>
							<select
									id='country-create'
									class="form-select form-select-sm manage-input"
									name='country'
									form='create'
							>
								<option value='null' selected>International</option>
								{% for country in countries %}
									<option value='{{ country.isoCode }}'>{{ country.isoCode }}
										- {{ country.englishName }}</option>
								{% endfor %}
							</select>
						</td>
						<td>
							<label for="mature-create" class='d-none'>Mature content</label>
							<input
									id="mature-create"
									class="w-100"
									type="checkbox"
									name="mature"
									form='create'
							/>
						</td>
						<td>
							<label for='month-create' class='d-none'>Month</label>
							<input
									required
									type='number'
									max='12'
									min='1'
									name='month'
									form='create'
									id='month-create'
									class='manage-input'
									value='{{ month }}'
							/>
						</td>
						<td>
							<label for='day-create' class='d-none'>Day</label>
							<input
									required
									type='number'
									max='31'
									min='1'
									name='day'
									form='create'
									id='day-create'
									class='manage-input'
							/>
						</td>
						<td>
							<label for='name-create' class='d-none'>Name</label>
							<textarea
									required
									style='min-height: 72px'
									name='name'
									class='w-100 manage-input'
									form='create'
									id='name-create'
							></textarea>
						</td>
						<td>
							<label for='description-create' class='d-none'>Description</label>
							<div class='d-flex align-items-center gap-1'>
								<textarea
										style='min-height: 72px'
										name='description'
										class='w-100 manage-input'
										form='create'
										id='description-create'
								></textarea>
								<button
										type='button'
										class='btn btn-sm btn-outline-light btn-generate-desc flex-shrink-0'
										title='Generate description with AI'
										data-target='description-create'
										data-name-source='name-create'
										data-month-source='month-create'
										data-day-source='day-create'
								><i class='bi bi-stars'></i></button>
							</div>
						</td>
						<td>
							<button type='submit' form='create' class='btn btn-sm btn-outline-light'><i
										class='bi bi-plus-lg'></i></button>
						</td>
					</tr>
					</tbody>
				</table>
			</div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
		</div>
	</main>

	<div
			class='modal fade'
			id='holidayEditModal'
			tabindex='-1'
			aria-labelledby='holidayEditModalLabel'
			aria-hidden='true'
			data-update-url='{{ path('admin_api_holiday_update') }}'
			data-csrf-token='{{ csrf_token('holiday_update') }}'
	>
		<div class='modal-dialog modal-dialog-centered modal-lg'>
			<div class='modal-content'>
				<div class='modal-header'>
					<h5 class='modal-title' id='holidayEditModalLabel'>Edit holiday</h5>
					<button type='button' class='btn-close' data-bs-dismiss='modal' aria-label='Close'></button>
				</div>
				<div class='modal-body'>
					<input type='hidden' id='edit-metadata-id'>
					<div class='mb-3'>
						<label class='form-label' for='edit-name'>Name</label>
						<div class='d-flex align-items-start gap-2'>
							<textarea id='edit-name' class='form-control manage-input' rows='2'></textarea>
						</div>
					</div>
					<div class='mb-3'>
						<label class='form-label' for='edit-description'>Description</label>
						<div class='d-flex align-items-start gap-2'>
							<textarea id='edit-description' class='form-control manage-input' rows='6'></textarea>
							<button
									type='button'
									class='btn btn-sm btn-outline-light btn-generate-desc flex-shrink-0'
									title='Generate description with AI'
									id='edit-description-ai'
							><i class='bi bi-stars'></i></button>
						</div>
					</div>
					<div class='row g-3 mb-3'>
						<div class='col-sm-3'>
							<label class='form-label' for='edit-day'>Day</label>
							<input type='number' min='1' max='31' id='edit-day' class='form-control manage-input'>
						</div>
						<div class='col-sm-3'>
							<label class='form-label' for='edit-month'>Month</label>
							<input type='number' min='1' max='12' id='edit-month' class='form-control manage-input'>
						</div>
						<div class='col-sm-6'>
							<label class='form-label' for='edit-country'>Country</label>
							<select id='edit-country' class='form-select manage-input'>
								<option value='null'>International</option>
								{% for country in countries %}
									<option value='{{ country.isoCode }}'>{{ country.isoCode }}
										- {{ country.englishName }}</option>
								{% endfor %}
							</select>
						</div>
					</div>
					<div class='form-check form-switch mb-3'>
						<input class='form-check-input' type='checkbox' id='edit-mature'>
						<label class='form-check-label' for='edit-mature'>Mature content (+18)</label>
					</div>
					<div
							class='mb-2 tag-picker'
							id='edit-tags'
							data-tags='{{ tags|map(t => {id: t.id, slug: t.slug, name: t.nameFor('pl') ?? t.slug})|json_encode|e('html_attr') }}'
					>
						<label class='form-label'>Tags</label>
						<div class='tag-picker-chips chip-list' id='edit-tag-chips'></div>
						{% if tags is not empty %}
							<div class='dropdown tag-picker-dropdown'>
								<button
										class='btn btn-sm btn-outline-light dropdown-toggle tag-picker-add'
										type='button'
										id='edit-tag-add'
										data-bs-toggle='dropdown'
										data-bs-auto-close='outside'
										aria-expanded='false'
								>
									<i class='bi bi-plus-lg'></i> Add tag
								</button>
								<ul class='dropdown-menu dropdown-menu-dark tag-picker-menu'
								    aria-labelledby='edit-tag-add' id='edit-tag-menu'></ul>
							</div>
						{% else %}
							<p class='text-muted small mb-0'>No tags defined yet.</p>
						{% endif %}
					</div>
					<div class='alert alert-danger d-none' id='edit-error' role='alert'></div>
				</div>
				<div class='modal-footer'>
					<button type='button' class='btn btn-outline-light' data-bs-dismiss='modal' id='edit-cancel'>
						<i class='bi bi-x-lg me-1'></i>Cancel
					</button>
					<button type='button' class='btn btn-primary' id='edit-accept'>
						<i class='bi bi-check-lg me-1'></i>Accept
					</button>
				</div>
			</div>
		</div>
	</div>

{% endblock %}
