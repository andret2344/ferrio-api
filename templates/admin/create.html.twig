{% extends 'base.html.twig' %}
{% block body %}
	<main class='section-manage-main' data-page='admin-create' data-current-month='{{ month }}'>
		{% include 'components/sidebar.html.twig' %}
		{% set toolbar_html %}
			<a href='{{ path('admin_holiday_new', {kind: 'fixed'}) }}?month={{ month }}'
			   class='btn btn-sm btn-primary'>
				<i class='bi bi-plus-lg me-1'></i>Add holiday
			</a>
		{% endset %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Fixed Holidays', toolbar: toolbar_html} %}
		<div class='manage-content'>
			<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
			<div class='table-responsive'>
				<table class="table table-dark table-striped table-hover align-middle">
					<caption>Holidays</caption>
					<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col" style='min-width: 142px'>Country</th>
						<th scope="col" class='text-center'>Day</th>
						<th scope="col" class='w-25'>Name</th>
						<th scope="col" class='w-75'>Description</th>
						<th scope="col" class='text-center'>Tags</th>
						<th scope="col" class='text-center'>Translations</th>
						<th scope="col" class='mature-col'><span class='visually-hidden'>Mature</span></th>
					</tr>
					</thead>
					<tbody>
					{% for element in fixed_holidays %}
						<tr
								class='tr-holiday tr-holiday-clickable'
								role='button'
								tabindex='0'
								data-href='{{ path('admin_holiday_detail', {kind: 'fixed', id: element.id}) }}'
						>
							<th scope="row">{{ element.id }}</th>
							<td>
								{% if element.countryName %}
									{{ element.countryCode }} - {{ element.countryName }}
								{% else %}
									International
								{% endif %}
							</td>
							<td class='text-center'>{{ element.day }}</td>
							<td>
								<div class='holiday-name'>{{ element.name }}</div>
							</td>
							<td>
								<div class='holiday-description'>{{ element.description|nl2br }}</div>
							</td>
							<td class='text-center'>{{ tagCounts[element.id]|default(0) }}</td>
							<td class='text-center'>{% include 'admin/components/translation_count.html.twig' with {count: translationCounts[element.id]|default(0), total: targetLanguageCount} only %}</td>
							<td class='mature-col'>{% include 'admin/components/mature_badge.html.twig' with {mature: element.matureContent} only %}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
		</div>
	</main>
{% endblock %}
