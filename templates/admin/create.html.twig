{% extends 'base.html.twig' %}
{% block body %}
	<main class='section-manage-main' data-page='admin-create' data-current-month='{{ month }}'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Fixed Holidays'} %}
		<div class='manage-content'>
			<div id="toast-container" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
			<div class='table-responsive'>
				<table class="table table-dark table-striped table-hover align-middle">
					<caption>Holidays</caption>
					<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col" style='min-width: 142px'>Country</th>
						<th scope="col">+18</th>
						<th scope="col">Month</th>
						<th scope="col">Day</th>
						<th scope="col" class='w-25'>Name</th>
						<th scope="col" class='w-75'>Description</th>
						<th scope="col">Translations</th>
					</tr>
					</thead>
					<tbody>
					{% for element in fixed_holidays %}
						<tr
								class='tr-holiday tr-holiday-clickable'
								role='button'
								tabindex='0'
								data-href='{{ path('admin_holiday_detail', {kind: 'fixed', id: element.id}) }}'
						>
							<th scope="row">{{ element.id }}</th>
							<td>
								{% if element.countryName %}
									{{ element.countryCode }} - {{ element.countryName }}
								{% else %}
									International
								{% endif %}
							</td>
							<td>{{ element.matureContent ? 'Yes' : 'No' }}</td>
							<td>{{ element.month }}</td>
							<td>{{ element.day }}</td>
							<td>{{ element.name }}</td>
							<td>
								<div class='holiday-description'>{{ element.description|nl2br }}</div>
							</td>
							<td>{% include 'admin/components/translation_count.html.twig' with {count: translationCounts[element.id]|default(0), total: targetLanguageCount} only %}</td>
						</tr>
					{% endfor %}
					</tbody>
				</table>
			</div>
			<form id='create' method='post'>
				<input type='hidden' name='action' value='create' form='create'/>
				{{ form_widget(createForm._token) }}
			</form>
			<div class='table-responsive'>
				<table class='table table-dark table-striped table-hover align-middle'>
					<caption>Adding</caption>
					<thead>
					<tr>
						<th scope="col">#</th>
						<th scope="col">Country</th>
						<th scope="col">+18</th>
						<th scope="col">Month</th>
						<th scope="col">Day</th>
						<th scope="col" class='w-25'>Name</th>
						<th scope="col" class='w-75'>Description</th>
						<th scope="col">Action</th>
					</tr>
					</thead>
					<tbody>
					<tr>
						<th scope="row">#</th>
						<td>
							<label for='country-create' class='d-none'>Country</label>
							<select
									id='country-create'
									class="form-select form-select-sm manage-input"
									name='country'
									form='create'
							>
								<option value='null' selected>International</option>
								{% for country in countries %}
									<option value='{{ country.isoCode }}'>{{ country.isoCode }}
										- {{ country.englishName }}</option>
								{% endfor %}
							</select>
						</td>
						<td>
							<label for="mature-create" class='d-none'>Mature content</label>
							<input
									id="mature-create"
									class="w-100"
									type="checkbox"
									name="mature"
									form='create'
							/>
						</td>
						<td>
							<label for='month-create' class='d-none'>Month</label>
							<input
									required
									type='number'
									max='12'
									min='1'
									name='month'
									form='create'
									id='month-create'
									class='manage-input'
									value='{{ month }}'
							/>
						</td>
						<td>
							<label for='day-create' class='d-none'>Day</label>
							<input
									required
									type='number'
									max='31'
									min='1'
									name='day'
									form='create'
									id='day-create'
									class='manage-input'
							/>
						</td>
						<td>
							<label for='name-create' class='d-none'>Name</label>
							<textarea
									required
									style='min-height: 72px'
									name='name'
									class='w-100 manage-input'
									form='create'
									id='name-create'
							></textarea>
						</td>
						<td>
							<label for='description-create' class='d-none'>Description</label>
							<div class='d-flex align-items-center gap-1'>
								<textarea
										style='min-height: 72px'
										name='description'
										class='w-100 manage-input'
										form='create'
										id='description-create'
								></textarea>
								<button
										type='button'
										class='btn btn-sm btn-outline-light btn-generate-desc flex-shrink-0'
										title='Generate description with AI'
										data-target='description-create'
										data-name-source='name-create'
										data-month-source='month-create'
										data-day-source='day-create'
								><i class='bi bi-stars'></i></button>
							</div>
						</td>
						<td>
							<button type='submit' form='create' class='btn btn-sm btn-outline-light'><i
										class='bi bi-plus-lg'></i></button>
						</td>
					</tr>
					</tbody>
				</table>
			</div>
			{% include 'components/month-navigation.html.twig' with {'month': month, 'url': '/admin/create/'} %}
		</div>
	</main>
{% endblock %}
