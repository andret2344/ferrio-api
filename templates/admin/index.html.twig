{% extends 'base.html.twig' %}
{% block title %}Dashboard - Ferrio Admin{% endblock %}
{% block body %}
	{% set nav = admin_nav() %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'Dashboard'} %}
		<div class='manage-content'>
			<div class='dashboard-grid'>
				<a href='{{ path('admin_create') }}' class='dashboard-stat no-a'>
					<div class='dashboard-stat-icon'><i class='bi bi-calendar-event'></i></div>
					<div class='dashboard-stat-body'>
						<div class='dashboard-stat-label'>Fixed holidays</div>
						<div class='dashboard-stat-value'>{{ fixedHolidayCount | number_format(0, '.', ' ') }}</div>
					</div>
				</a>
				<a href='{{ path('admin_floating') }}' class='dashboard-stat no-a'>
					<div class='dashboard-stat-icon'><i class='bi bi-calendar2-range'></i></div>
					<div class='dashboard-stat-body'>
						<div class='dashboard-stat-label'>Floating holidays</div>
						<div class='dashboard-stat-value'>{{ floatingHolidayCount | number_format(0, '.', ' ') }}</div>
					</div>
				</a>
				<a href='{{ path('admin_tags_index') }}' class='dashboard-stat no-a'>
					<div class='dashboard-stat-icon'><i class='bi bi-tag'></i></div>
					<div class='dashboard-stat-body'>
						<div class='dashboard-stat-label'>Tags</div>
						<div class='dashboard-stat-value'>{{ tagCount | number_format(0, '.', ' ') }}</div>
					</div>
				</a>
				<a href='{{ path('admin_languages_index') }}' class='dashboard-stat no-a'>
					<div class='dashboard-stat-icon'><i class='bi bi-translate'></i></div>
					<div class='dashboard-stat-body'>
						<div class='dashboard-stat-label'>Languages</div>
						<div class='dashboard-stat-value'>{{ languages|length | number_format(0, '.', ' ') }}</div>
					</div>
				</a>
				<a href='{{ path('admin_reports_index') }}'
				   class='dashboard-stat no-a {{ nav.reportsPending > 0 ? 'dashboard-stat-warning' : '' }}'>
					<div class='dashboard-stat-icon'><i class='bi bi-flag'></i></div>
					<div class='dashboard-stat-body'>
						<div class='dashboard-stat-label'>Pending reports</div>
						<div class='dashboard-stat-value'>{{ nav.reportsPending | number_format(0, '.', ' ') }}</div>
					</div>
					{% if nav.reportsPending > 0 %}
						<span class='dashboard-stat-pulse' aria-hidden='true'></span>
					{% endif %}
				</a>
			</div>

			<div class='dashboard-panels'>
				<section class='dashboard-panel'>
					<header class='dashboard-panel-header'>
						<i class='bi bi-flag'></i>
						<span>Reports</span>
					</header>
					<div class='dashboard-panel-body'>
						{% for item in [
							{kind: 'fixed_suggestion', type: 'fixed-suggestions', label: 'Fixed suggestions', icon: 'bi-lightbulb'},
							{kind: 'floating_suggestion', type: 'floating-suggestions', label: 'Floating suggestions', icon: 'bi-lightbulb'},
							{kind: 'fixed_error', type: 'fixed-errors', label: 'Fixed errors', icon: 'bi-exclamation-triangle'},
							{kind: 'floating_error', type: 'floating-errors', label: 'Floating errors', icon: 'bi-exclamation-triangle'},
						] %}
							{% set rc = reportCounts[item.kind] %}
							<a href='{{ path('admin_reports', {type: item.type}) }}'
							   class='dashboard-report-row no-a {{ rc.reported > 0 ? 'dashboard-report-row-warning' : '' }}'>
								<i class='bi {{ item.icon }}'></i>
								<span class='dashboard-report-label'>{{ item.label }}</span>
								<span class='dashboard-report-value'>
									<strong>{{ rc.reported }}</strong>
									<span class='dashboard-report-sep'>/</span>
									{{ rc.total }}
								</span>
							</a>
						{% endfor %}
					</div>
				</section>

				<section class='dashboard-panel'>
					<header class='dashboard-panel-header'>
						<i class='bi bi-translate'></i>
						<span>Translation progress</span>
					</header>
					<div class='dashboard-panel-body'>
						{% set fixedTotal = translationTotalsByKind.fixed %}
						{% set floatingTotal = translationTotalsByKind.floating %}
						{% set combinedTotal = fixedTotal + floatingTotal %}
						{% for language in languages %}
							{% if language.code != 'pl' %}
								{% set fixedCount = translationCountsByKind.fixed[language.code] ?? 0 %}
								{% set floatingCount = translationCountsByKind.floating[language.code] ?? 0 %}
								{% set combinedCount = fixedCount + floatingCount %}
								{% set fixedComplete = fixedCount >= fixedTotal %}
								{% set floatingComplete = floatingCount >= floatingTotal %}
								{% set allComplete = fixedComplete and floatingComplete %}
								{% set pct = allComplete ? 100 : (combinedTotal > 0 ? (combinedCount / combinedTotal * 100) : 0) %}
								<div class='dashboard-translate-row'>
									<span class='dashboard-translate-name'>{{ language.name }}</span>
									<div class='dashboard-translate-bar'>
										<div class='dashboard-translate-bar-fill {{ allComplete ? 'dashboard-translate-bar-fill-complete' : '' }}'
											 style='width: {{ pct }}%'></div>
									</div>
									<div class='dashboard-translate-counts'>
										{% for kindRow in [
											{kind: 'fixed', icon: 'bi-calendar-event', count: fixedCount, total: fixedTotal, complete: fixedComplete, label: 'Fixed'},
											{kind: 'floating', icon: 'bi-calendar2-range', count: floatingCount, total: floatingTotal, complete: floatingComplete, label: 'Floating'}
										] %}
											{% if kindRow.complete %}
												<span class='dashboard-translate-count' title='{{ kindRow.label }}: {{ kindRow.count }} / {{ kindRow.total }}'>
													<i class='bi {{ kindRow.icon }}'></i>
													<span>{{ kindRow.count }} / {{ kindRow.total }}</span>
												</span>
											{% else %}
												<a class='dashboard-translate-count dashboard-translate-count-warning no-a'
												   href='{{ path('admin_missing', {kind: kindRow.kind, lang: language.code}) }}'
												   title='{{ kindRow.label }}: {{ kindRow.count }} / {{ kindRow.total }}'>
													<i class='bi {{ kindRow.icon }}'></i>
													<span>{{ kindRow.count }} / {{ kindRow.total }}</span>
												</a>
											{% endif %}
										{% endfor %}
									</div>
								</div>
							{% endif %}
						{% endfor %}
					</div>
				</section>
			</div>
		</div>
	</main>
{% endblock %}
