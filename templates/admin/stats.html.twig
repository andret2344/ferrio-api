{% extends 'base.html.twig' %}
{% block title %}Stats - Ferrio Admin{% endblock %}
{% block body %}
	<main class='section-manage-main'>
		{% include 'components/sidebar.html.twig' %}
		{% include 'components/topbar.html.twig' with {pageTitle: 'API traffic'} %}
		<div class='manage-content'>

			<form method='get' class='mb-4 d-flex gap-2 flex-wrap' data-stats-form>
				<select name='group' class='form-select manage-input' style='width: auto'>
					{% for option in groupings %}
						<option value='{{ option }}' {{ option == grouping ? 'selected' : '' }}>
							By {{ option }}
						</option>
					{% endfor %}
				</select>
				<select name='days' class='form-select manage-input' style='width: auto'>
					{% for range in ranges %}
						<option value='{{ range }}' {{ range == days ? 'selected' : '' }}>
							{{ range == 0 ? 'All time' : 'Last ' ~ range ~ ' day' ~ (range == 1 ? '' : 's') }}
						</option>
					{% endfor %}
				</select>
				<noscript>
					<button type='submit' class='btn btn-primary'>Apply</button>
				</noscript>
			</form>

			{% if stats.total == 0 %}
				<p class='text-muted'>No API hits recorded in this range.</p>
			{% else %}
				<div class='d-flex gap-3 mb-4 flex-wrap'>
					{% for version in stats.versions %}
						<div class='card bg-dark text-light px-3 py-2'>
							<span class='text-muted small'>{{ version }}</span>
							<strong>{{ stats.version_totals[version] | number_format(0, '.', ' ') }}</strong>
						</div>
					{% endfor %}
					<div class='card bg-dark text-light px-3 py-2'>
						<span class='text-muted small'>Total</span>
						<strong>{{ stats.total | number_format(0, '.', ' ') }}</strong>
					</div>
				</div>

				<div class='table-responsive'>
					<table class='table table-dark table-striped table-hover align-middle'>
						<thead>
						<tr>
							<th>{{ grouping | capitalize }}</th>
							{% for version in stats.versions %}
								<th class='text-center'>{{ version }}</th>
							{% endfor %}
							<th class='text-center'>Total</th>
							{% for path in stats.paths %}
								<th class='text-center text-nowrap'>
									<code>{{ path }}</code>
								</th>
							{% endfor %}
						</tr>
						</thead>
						<tbody>
						{% for period in stats.periods %}
							<tr>
								<td class='text-nowrap'>{{ period }}</td>
								{% for version in stats.versions %}
									<td class='text-center'>{{ stats.version_cells[period][version] ?? 0 }}</td>
								{% endfor %}
								<td class='text-center'><strong>{{ stats.period_totals[period] }}</strong></td>
								{% for path in stats.paths %}
									<td class='text-center'>{{ stats.cells[period][path] ?? 0 }}</td>
								{% endfor %}
							</tr>
						{% endfor %}
						</tbody>
						<tfoot>
						<tr>
							<th>All</th>
							{% for version in stats.versions %}
								<th class='text-center'>{{ stats.version_totals[version] }}</th>
							{% endfor %}
							<th class='text-center'>{{ stats.total }}</th>
							{% for path in stats.paths %}
								<th class='text-center'>{{ stats.path_totals[path] }}</th>
							{% endfor %}
						</tr>
						</tfoot>
					</table>
				</div>
			{% endif %}
		</div>
	</main>

	<script>
		document.querySelectorAll('[data-stats-form] select').forEach(select =>
			select.addEventListener('change', () => select.form.submit()));
	</script>
{% endblock %}
