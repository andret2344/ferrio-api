{# @var kind string  Report kind (e.g. 'fixed_suggestion') — drives column set + row data attributes. #}
{# @var emptyLabel string  Human label for the empty state ("fixed holiday suggestions"). #}
{# @var rows iterable  Report rows (suggestion or error entities). #}
{# @var users array  uid => user info. #}
{# @var defaultLang string  PL source language code, used as referred-holiday fallback. #}
{# @var fixedHolidays array  "metadataId:lang" => {name, description} for fixed referred data. #}
{# @var floatingHolidays array  "metadataId:lang" => {name, description} for floating referred data. #}

{% set isError = kind ends with '_error' %}
{% set isFloating = kind starts with 'floating_' %}
{% set pending = rows|filter(r => r.reportState.value == 'REPORTED')|length %}

{% macro platform_icon(platform) %}
	{% set icon = {
		'android': {'cls': 'bi-android2', 'label': 'Android'},
		'ios': {'cls': 'bi-apple', 'label': 'iOS'},
		'web': {'cls': 'bi-globe', 'label': 'Web'},
		'api': {'cls': 'bi-braces', 'label': 'API'},
	} %}
	{% if platform and icon[platform] is defined %}
		<span class='platform-icon platform-icon-{{ platform }}'
		      data-bs-toggle='tooltip'
		      title='{{ icon[platform].label }}'>
			<i class='bi {{ icon[platform].cls }}'></i>
		</span>
	{% else %}
		<span class='platform-icon platform-icon-unknown' title='Unknown'>
			<i class='bi bi-question-circle'></i>
		</span>
	{% endif %}
{% endmacro %}

<div class='reports-summary'>
	<span class='reports-summary-total'>
		<span class='reports-summary-num' data-role='total-count'>{{ rows|length }}</span>
		<span class='reports-summary-noun' data-role='total-noun'>{{ rows|length == 1 ? 'report' : 'reports' }}</span>
	</span>
	<span class='reports-summary-pending {{ pending > 0 ? '' : 'd-none' }}' data-role='pending-pill'>
		<span class='reports-summary-dot'></span>
		<span data-role='pending-count'>{{ pending }}</span>
		pending
	</span>
</div>
{% if rows is empty %}
	<div class='text-center text-muted py-5'>No {{ emptyLabel }}.</div>
{% else %}
	<div class='table-responsive'>
		<table class='table table-dark table-striped table-hover align-middle reports-table'>
			<thead>
			<tr>
				<th data-sort='index'>#</th>
				<th class='platform-col' data-sort='platform' title='Platform'><i class='bi bi-phone'></i></th>
				{% if isError %}
					<th data-sort='type'>Type</th>
				{% else %}
					<th data-sort='name'>Name</th>
					<th data-sort='date'>Date</th>
				{% endif %}
				<th data-sort='description'>Description</th>
				{% if not isError %}
					<th data-sort='country'>Country</th>
				{% endif %}
				<th data-sort='state'>State</th>
				<th data-sort='datetime'>Reported</th>
				<th data-sort='user'>User</th>
				{% if not isError %}
					<th class='holiday-link-col' title='Holiday'></th>
				{% endif %}
			</tr>
			</thead>
			<tbody>
			{% for r in rows %}
				{# Resolve linked metadata id + referent (in the reported language, PL fallback) + edit payload uniformly. #}
				{% set linkedId = isError ? (r.metadata ? r.metadata.id : null) : (r.holiday ? r.holiday.id : null) %}
				{% set referredMap = isFloating ? floatingHolidays : fixedHolidays %}
				{% set refData = isError ? (referredMap[linkedId ~ ':' ~ r.language.code] ?? referredMap[linkedId ~ ':' ~ defaultLang] ?? null) : null %}
				{% set referredName = isError ? (refData ? refData.name : null) : null %}
				{% set referredDescription = isError ? (refData ? refData.description : null) : null %}
				{% set reportDate = isError ? '' : (isFloating ? r.date : '%02d.%02d'|format(r.day, r.month)) %}
				{% set reportCountry = isError ? '' : (r.country ? r.country.isoCode : '') %}
				{% set deviceCountryCode = r.deviceCountry ?? '' %}
				{% set reportType = isError ? r.reportType.value : '' %}
				{% set detailHref = linkedId
					? path('admin_holiday_detail', {kind: isFloating ? 'floating' : 'fixed', id: linkedId})
					: '' %}
				{% set platformValue = r.platform ? r.platform.value : '' %}
				{% set u = users[r.userId] ?? null %}
				<tr
						class='report-row'
						role='button'
						tabindex='0'
						data-kind='{{ kind }}'
						data-id='{{ r.id }}'
						data-state='{{ r.reportState.value }}'
						data-comment='{{ (r.comment ?? '')|e('html_attr') }}'
						data-holiday-id='{{ linkedId ?? '' }}'
						data-report-name='{{ (isError ? '' : r.name)|e('html_attr') }}'
						data-report-description='{{ (r.description ?? '')|e('html_attr') }}'
						data-report-date='{{ reportDate }}'
						data-report-country='{{ reportCountry }}'
						data-report-type='{{ reportType }}'
						data-report-datetime='{{ r.datetime|date('Y-m-d H:i:s') }}'
						data-report-user-id='{{ r.userId|e('html_attr') }}'
						data-report-user-name='{{ (u ? (u.name ?? '') : '')|e('html_attr') }}'
						data-report-user-email='{{ (u ? (u.email ?? '') : '')|e('html_attr') }}'
						data-report-user-avatar='{{ (u ? (u.avatar ?? '') : '')|e('html_attr') }}'
						data-platform='{{ platformValue }}'
						data-real-device='{{ (r.realDevice ?? '')|e('html_attr') }}'
						data-device-country='{{ deviceCountryCode }}'
						data-os-version='{{ (r.osVersion ?? '')|e('html_attr') }}'
						data-app-version='{{ (r.appVersion ?? '')|e('html_attr') }}'
						data-app-build='{{ r.appBuild ?? '' }}'
						data-referred-name='{{ (referredName ?? '')|e('html_attr') }}'
						data-referred-description='{{ (referredDescription ?? '')|e('html_attr') }}'
						data-referred-lang='{{ isError ? r.language.code : '' }}'
						data-detail-href='{{ detailHref }}'
				>
					<td data-sort-value='{{ loop.index }}'>{{ loop.index }}</td>
					<td class='platform-col' data-sort-value='{{ platformValue }}'>{{ _self.platform_icon(platformValue) }}</td>
					{% if isError %}
						<td data-sort-value='{{ reportType }}'>
							<span class='badge bg-light text-dark'>{{ r.reportType.value|lower|replace({'_': ' '})|capitalize }}</span>
						</td>
						{% if r.description %}
							<td class='description-cell' data-sort-value='{{ r.description|e('html_attr') }}'>
								<span class='description-text'>{{ r.description }}</span>
							</td>
						{% else %}
							<td data-sort-value=''>-</td>
						{% endif %}
					{% else %}
						<td data-sort-value='{{ r.name|e('html_attr') }}'>{{ r.name }}</td>
						<td data-sort-value='{{ isFloating ? r.date : '%02d%02d'|format(r.month, r.day) }}'>{{ isFloating ? r.date : '%02d.%02d'|format(r.day, r.month) }}</td>
						<td class='description-cell' data-sort-value='{{ r.description|e('html_attr') }}'>
							<span class='description-text'>{{ r.description }}</span>
						</td>
						<td data-sort-value='{{ reportCountry }}'>{{ r.country ? r.country.isoCode : '-' }}</td>
					{% endif %}
					<td data-sort-value='{{ r.reportState.value }}'>
						<span class='state-cell'>
							<span class='badge report-state report-state-{{ r.reportState.value|lower }}'
							      data-role='state-badge'>
								{{ r.reportState.value }}
							</span>
							<button type='button'
							        class='btn btn-comment-icon {{ r.comment ? '' : 'd-none' }}'
							        data-role='comment-popover'
							        data-bs-toggle='popover'
							        data-bs-trigger='focus'
							        data-bs-placement='top'
							        data-bs-title='Comment'
							        data-bs-content='{{ r.comment ?? '' }}'
							        tabindex='0'
							        title='Show comment'>
								<i class='bi bi-chat-left-text-fill'></i>
							</button>
						</span>
					</td>
					<td data-sort-value='{{ r.datetime|date('Y-m-d H:i:s') }}'>{{ r.datetime|date('Y-m-d H:i') }}</td>
					<td class='user-cell' data-sort-value='{{ (u ? (u.name ?? '') : r.userId)|e('html_attr') }}' title='{{ r.userId }}'>
						{% set u = users[r.userId] ?? null %}
						{% if u and (u.name or u.email) %}
							<div class='user-name'>{{ u.name ?? '-' }}</div>
							<div class='user-email'>{{ u.email ?? '-' }}</div>
						{% else %}
							<div class='user-uid'>{{ r.userId }}</div>
						{% endif %}
					</td>
					{% if not isError %}
						<td class='holiday-link-cell text-center'>
							{% if detailHref %}
								<a href='{{ detailHref }}' class='holiday-link' title='Open holiday'>
									<i class='bi bi-box-arrow-up-right'></i>
								</a>
							{% endif %}
						</td>
					{% endif %}
				</tr>
			{% endfor %}
			</tbody>
		</table>
	</div>
{% endif %}
