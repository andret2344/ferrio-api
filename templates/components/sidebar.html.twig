{% set nav = admin_nav() %}
{% set route = app.request.attributes.get('_route') %}
{% set routeKind = app.request.attributes.get('kind') %}
{% set holidaysActive = route in ['admin_create', 'admin_create_month', 'admin_floating'] %}
{% set missingActive = route in ['admin_missing', 'admin_missing_overview'] %}
{% set reportsActive = route in ['admin_reports', 'admin_reports_index'] %}
{% set usersActive = route starts with 'admin_users_' %}
{% set reportType = app.request.attributes.get('type') %}
<script>
	(() => {
		try {
			if (localStorage.getItem('adminSidebarCollapsed') === '1') {
				document.documentElement.classList.add('sidebar-collapsed');
			}
		} catch (e) {
		}
	})();
</script>
<aside class='admin-sidebar'>
	<div class='sidebar-header'>
		<a href='{{ path('admin_index') }}' class='sidebar-brand no-a'>
			<i class='bi bi-calendar2-heart'></i>
			<span class='sidebar-label'>FERRIO</span>
		</a>
		<button type='button' class='sidebar-toggle' data-sidebar-toggle aria-label='Toggle sidebar'>
			<i class='bi bi-chevron-double-left'></i>
		</button>
	</div>
	<nav class='sidebar-nav'>
		<a href='{{ path('admin_index') }}'
		   class='sidebar-item no-a {{ route == 'admin_index' ? 'sidebar-item-active' : '' }}'
		   title='Dashboard'>
			<i class='bi bi-speedometer2'></i>
			<span class='sidebar-label'>Dashboard</span>
		</a>
		<a href='{{ path('admin_stats') }}'
		   class='sidebar-item no-a {{ route == 'admin_stats' ? 'sidebar-item-active' : '' }}'
		   title='API traffic'>
			<i class='bi bi-graph-up'></i>
			<span class='sidebar-label'>Stats</span>
		</a>
		<hr class='sidebar-divider'>
		<div class='sidebar-group {{ holidaysActive ? 'sidebar-group-active' : '' }}'>
			<button type='button' class='sidebar-group-title' data-sidebar-group='holidays' aria-expanded='true'
			        title='Holidays'>
				<i class='bi bi-calendar-event'></i>
				<span class='sidebar-label'>Holidays</span>
				<i class='bi bi-chevron-down sidebar-chevron'></i>
			</button>
			<a href='{{ path('admin_create') }}'
			   class='sidebar-subitem no-a {{ route in ['admin_create', 'admin_create_month'] ? 'sidebar-item-active' : '' }}'
			   title='Fixed ({{ nav.fixedCount }})'>
				<i class='bi bi-calendar-event sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Fixed</span>
				<span class='sidebar-badge'>{{ nav.fixedCount | number_format(0, '.', ' ') }}</span>
			</a>
			<a href='{{ path('admin_floating') }}'
			   class='sidebar-subitem no-a {{ route == 'admin_floating' ? 'sidebar-item-active' : '' }}'
			   title='Floating ({{ nav.floatingCount }})'>
				<i class='bi bi-calendar2-range sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Floating</span>
				<span class='sidebar-badge'>{{ nav.floatingCount | number_format(0, '.', ' ') }}</span>
			</a>
		</div>
		<a href='{{ path('admin_tags_index') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_tags_' ? 'sidebar-item-active' : '' }}'
		   title='Tags ({{ nav.tagCount }})'>
			<i class='bi bi-tag'></i>
			<span class='sidebar-label'>Tags</span>
			<span class='sidebar-badge'>{{ nav.tagCount }}</span>
		</a>
		<a href='{{ path('admin_languages_index') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_languages_' ? 'sidebar-item-active' : '' }}'
		   title='Languages ({{ nav.languageCount }})'>
			<i class='bi bi-translate'></i>
			<span class='sidebar-label'>Languages</span>
			<span class='sidebar-badge'>{{ nav.languageCount }}</span>
		</a>
		<hr class='sidebar-divider'>
		<div class='sidebar-group {{ missingActive ? 'sidebar-group-active' : '' }}'>
			<button type='button' class='sidebar-group-title' data-sidebar-group='missing' aria-expanded='true'
			        title='Missing translations'>
				<i class='bi bi-translate'></i>
				<span class='sidebar-label'>Missing translations</span>
				{% if nav.fixedMissing > 0 or nav.floatingMissing > 0 %}
					<i class='bi bi-exclamation-triangle sidebar-warning' title='Missing translations'></i>
				{% endif %}
				<i class='bi bi-chevron-down sidebar-chevron'></i>
			</button>
			<a href='{{ path('admin_missing_overview', {kind: 'fixed'}) }}'
			   class='sidebar-subitem no-a {{ missingActive and routeKind == 'fixed' ? 'sidebar-item-active' : '' }}'
			   title='Missing fixed translations ({{ nav.fixedMissing }})'>
				<i class='bi bi-calendar-event sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Fixed</span>
				{% if nav.fixedMissing > 0 %}
					<span class='sidebar-badge sidebar-badge-warning'>{{ nav.fixedMissing | number_format(0, '.', ' ') }}</span>
				{% else %}
					<span class='sidebar-badge'>0</span>
				{% endif %}
			</a>
			<a href='{{ path('admin_missing_overview', {kind: 'floating'}) }}'
			   class='sidebar-subitem no-a {{ missingActive and routeKind == 'floating' ? 'sidebar-item-active' : '' }}'
			   title='Missing floating translations ({{ nav.floatingMissing }})'>
				<i class='bi bi-calendar2-range sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Floating</span>
				{% if nav.floatingMissing > 0 %}
					<span class='sidebar-badge sidebar-badge-warning'>{{ nav.floatingMissing | number_format(0, '.', ' ') }}</span>
				{% else %}
					<span class='sidebar-badge'>0</span>
				{% endif %}
			</a>
		</div>
		<div class='sidebar-group {{ reportsActive ? 'sidebar-group-active' : '' }}'>
			<button type='button' class='sidebar-group-title' data-sidebar-group='reports' aria-expanded='true'
			        title='Reports'>
				<i class='bi bi-flag'></i>
				<span class='sidebar-label'>Reports</span>
				{% if nav.reportsPending > 0 %}
					<i class='bi bi-exclamation-triangle sidebar-warning' title='Pending reports'></i>
				{% endif %}
				<i class='bi bi-chevron-down sidebar-chevron'></i>
			</button>
			{% for entry in [
				{type: 'fixed-suggestions', kind: 'fixed_suggestion', label: 'Fixed suggestions', icon: 'bi-lightbulb'},
				{type: 'floating-suggestions', kind: 'floating_suggestion', label: 'Floating suggestions', icon: 'bi-lightbulb-fill'},
				{type: 'fixed-errors', kind: 'fixed_error', label: 'Fixed errors', icon: 'bi-exclamation-triangle'},
				{type: 'floating-errors', kind: 'floating_error', label: 'Floating errors', icon: 'bi-exclamation-triangle-fill'},
			] %}
				{% set pending = nav.reportsByKind[entry.kind] ?? 0 %}
				<a href='{{ path('admin_reports', {type: entry.type}) }}'
				   class='sidebar-subitem no-a {{ reportsActive and reportType == entry.type ? 'sidebar-item-active' : '' }}'
				   title='{{ entry.label }}{{ pending > 0 ? ' (' ~ pending ~ ' pending)' : '' }}'>
					<i class='bi {{ entry.icon }} sidebar-subitem-icon'></i>
					<span class='sidebar-label'>{{ entry.label }}</span>
					{% if pending > 0 %}
						<span class='sidebar-badge sidebar-badge-warning'>{{ pending }}</span>
					{% else %}
						<span class='sidebar-badge'>0</span>
					{% endif %}
				</a>
			{% endfor %}
		</div>
		<div class='sidebar-group {{ usersActive ? 'sidebar-group-active' : '' }}'>
			<button type='button' class='sidebar-group-title' data-sidebar-group='users' aria-expanded='true'
			        title='Users'>
				<i class='bi bi-people'></i>
				<span class='sidebar-label'>Users</span>
				{% if nav.bannedCount > 0 %}
					<i class='bi bi-slash-circle sidebar-warning' title='Banned users'></i>
				{% endif %}
				<i class='bi bi-chevron-down sidebar-chevron'></i>
			</button>
			<a href='{{ path('admin_users_index') }}'
			   class='sidebar-subitem no-a {{ route == 'admin_users_index' ? 'sidebar-item-active' : '' }}'
			   title='User stats'>
				<i class='bi bi-graph-up sidebar-subitem-icon'></i>
				<span class='sidebar-label'>User stats</span>
			</a>
			<a href='{{ path('admin_users_banned') }}'
			   class='sidebar-subitem no-a {{ route == 'admin_users_banned' ? 'sidebar-item-active' : '' }}'
			   title='Banned users ({{ nav.bannedCount }})'>
				<i class='bi bi-slash-circle sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Banned</span>
				{% if nav.bannedCount > 0 %}
					<span class='sidebar-badge sidebar-badge-danger'>{{ nav.bannedCount }}</span>
				{% else %}
					<span class='sidebar-badge'>0</span>
				{% endif %}
			</a>
		</div>
	</nav>
</aside>
