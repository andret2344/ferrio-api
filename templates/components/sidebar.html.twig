{% set nav = admin_nav() %}
{% set route = app.request.attributes.get('_route') %}
{% set holidaysActive = route in ['admin_create', 'admin_create_month', 'admin_floating'] %}
<script>
	(() => {
		try {
			if (localStorage.getItem('adminSidebarCollapsed') === '1') {
				document.documentElement.classList.add('sidebar-collapsed');
			}
		} catch (e) {
		}
	})();
</script>
<aside class='admin-sidebar'>
	<div class='sidebar-header'>
		<a href='{{ path('admin_index') }}' class='sidebar-brand no-a d-flex align-items-center gap-2'>
			<i class='bi bi-calendar2-heart'></i>
			<span class='sidebar-label'>FERRIO</span>
		</a>
		<button type='button' class='sidebar-toggle' data-sidebar-toggle aria-label='Toggle sidebar'>
			<i class='bi bi-chevron-double-left'></i>
		</button>
	</div>
	<nav class='sidebar-nav'>
		<a href='{{ path('admin_index') }}'
		   class='sidebar-item no-a {{ route == 'admin_index' ? 'sidebar-item-active' : '' }}'
		   title='Dashboard'>
			<i class='bi bi-speedometer2'></i>
			<span class='sidebar-label'>Dashboard</span>
		</a>
		<div class='sidebar-group {{ holidaysActive ? 'sidebar-group-active' : '' }}'>
			<div class='sidebar-group-title' title='Holidays'>
				<i class='bi bi-calendar-event'></i>
				<span class='sidebar-label'>Holidays</span>
			</div>
			<a href='{{ path('admin_create') }}'
			   class='sidebar-subitem no-a {{ route in ['admin_create', 'admin_create_month'] ? 'sidebar-item-active' : '' }}'
			   title='Fixed ({{ nav.fixedCount }})'>
				<i class='bi bi-calendar-event sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Fixed</span>
				<span class='sidebar-badge'>{{ nav.fixedCount | number_format(0, '.', ' ') }}</span>
			</a>
			<a href='{{ path('admin_floating') }}'
			   class='sidebar-subitem no-a {{ route == 'admin_floating' ? 'sidebar-item-active' : '' }}'
			   title='Floating ({{ nav.floatingCount }})'>
				<i class='bi bi-calendar2-range sidebar-subitem-icon'></i>
				<span class='sidebar-label'>Floating</span>
				<span class='sidebar-badge'>{{ nav.floatingCount | number_format(0, '.', ' ') }}</span>
			</a>
		</div>
		<a href='{{ path('admin_tags_index') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_tags_' ? 'sidebar-item-active' : '' }}'
		   title='Tags ({{ nav.tagCount }})'>
			<i class='bi bi-tag'></i>
			<span class='sidebar-label'>Tags</span>
			<span class='sidebar-badge'>{{ nav.tagCount }}</span>
		</a>
		<a href='{{ path('admin_reports') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_reports' ? 'sidebar-item-active' : '' }}'
		   title='Reports{{ nav.reportsPending > 0 ? ' (' ~ nav.reportsPending ~ ' pending)' : '' }}'>
			<i class='bi bi-flag'></i>
			<span class='sidebar-label'>Reports</span>
			{% if nav.reportsPending > 0 %}
				<span class='sidebar-badge sidebar-badge-warning'>{{ nav.reportsPending }}</span>
				<span class='sidebar-dot sidebar-dot-warning'></span>
			{% endif %}
		</a>
		<a href='{{ path('admin_translate_default') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_translate' ? 'sidebar-item-active' : '' }}'
		   title='Translate{{ nav.translateIncomplete > 0 ? ' (' ~ nav.translateIncomplete ~ ' incomplete)' : '' }}'>
			<i class='bi bi-translate'></i>
			<span class='sidebar-label'>Translate</span>
			{% if nav.translateIncomplete > 0 %}
				<span class='sidebar-badge sidebar-badge-warning'>{{ nav.translateIncomplete }}</span>
				<span class='sidebar-dot sidebar-dot-warning'></span>
			{% endif %}
		</a>
		<a href='{{ path('admin_polls_index') }}'
		   class='sidebar-item no-a {{ route starts with 'admin_polls_' ? 'sidebar-item-active' : '' }}'
		   title='Polls ({{ nav.pollCount }})'>
			<i class='bi bi-bar-chart-line'></i>
			<span class='sidebar-label'>Polls</span>
			<span class='sidebar-badge'>{{ nav.pollCount }}</span>
		</a>
	</nav>
</aside>
