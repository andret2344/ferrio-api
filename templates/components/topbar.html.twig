<header class='manage-topbar'>
	<div class='d-flex align-items-center px-4 py-3'>
		{% if pageTitle is defined and pageTitle %}
			<span class='topbar-title'>{{ pageTitle }}</span>
		{% endif %}
		{% if toolbar is defined and toolbar %}
			<div class='topbar-toolbar ms-auto d-flex align-items-center gap-2'>
				{{ toolbar|raw }}
			</div>
		{% endif %}
	</div>
</header>
