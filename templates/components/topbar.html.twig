<header class='manage-topbar'>
	<div class='d-flex align-items-center px-4 py-3'>
		{% if back is defined and back %}
			<div class='topbar-back d-flex align-items-center me-3'>
				{{ back|raw }}
			</div>
		{% endif %}
		{% if pageTitle is defined and pageTitle %}
			<span class='topbar-title'>{{ pageTitle }}</span>
		{% endif %}
		{% if toolbar is defined and toolbar %}
			<div class='topbar-toolbar ms-auto d-flex align-items-center gap-2'>
				{{ toolbar|raw }}
			</div>
		{% endif %}
		{% if app.user %}
			<div class='topbar-account dropdown {{ toolbar is defined and toolbar ? 'ms-3' : 'ms-auto' }}'>
				<button class='topbar-account-btn' type='button' data-bs-toggle='dropdown'
						data-bs-auto-close='outside' aria-expanded='false' aria-label='Account'>
					<img class='topbar-account-avatar' src='{{ app.user.avatarUrl }}' alt=''>
				</button>
				<div class='topbar-account-menu dropdown-menu dropdown-menu-end'>
					<div class='topbar-account-identity'>
						<div class='topbar-account-name'>{{ app.user.username }}</div>
						<div class='topbar-account-email'>{{ app.user.email }}</div>
					</div>
					<a class='topbar-account-logout'
					   href='{{ path('admin_logout', {_csrf_token: csrf_token('logout')}) }}'>
						<i class='bi bi-box-arrow-right me-2'></i>Logout
					</a>
				</div>
			</div>
		{% endif %}
	</div>
</header>
