{% extends 'base.html.twig' %}
{% block title %}Sign in - Ferrio Admin{% endblock %}
{% block body %}
	<main class='login-page'>
		{#
			The attributes here are what password managers key off: a real `action`, `id` and `name`
			matching the `autocomplete` token, and no `autocomplete='off'` anywhere. Keep them in
			sync with `username_parameter` / `password_parameter` in security.yaml.
		#}
		<form class='login-card' id='login-form' name='login' method='post' action='{{ path('index') }}'
			  autocomplete='on'>
			<h1 class='login-title'>Ferrio Admin</h1>
			<p class='login-subtitle'>Sign in to continue</p>

			{% if error %}
				<div class='login-error' role='alert'>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
			{% endif %}

			<label class='login-label' for='username'>E-mail or username</label>
			<input class='login-input' type='text' id='username' name='username'
				   value='{{ lastUsername }}' autocomplete='username' autocapitalize='none'
				   autocorrect='off' spellcheck='false' required autofocus>

			<label class='login-label' for='password'>Password</label>
			<input class='login-input' type='password' id='password' name='password'
				   autocomplete='current-password' autocapitalize='none' autocorrect='off'
				   spellcheck='false' required>

			<input type='hidden' name='_csrf_token' value='{{ csrf_token('authenticate') }}'>

			<button class='login-submit' type='submit'>Sign in</button>
		</form>
	</main>
{% endblock %}
