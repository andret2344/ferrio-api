# Production secrets. Copy to /opt/docker-images/ferrio-api/secrets.env on the server (never into the
# repository) and fill every value in. compose.yaml injects them into the php container as real environment
# variables, which win over the committed .env baked into the image.

# --- Symfony -------------------------------------------------------------------------------------
# Signs remember_me cookies and CSRF tokens. Must be your own: the value in the committed .env is
# public. Generate one: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
APP_SECRET=CHANGE_ME

# --- Database ------------------------------------------------------------------------------------
# Host MySQL over its unix socket (mounted by compose.yaml). With host=localhost the user is matched
# as 'user'@'localhost', same as a connection made on the host itself. Use the server's real
# serverVersion so Doctrine never has to connect just to detect it.
DATABASE_URL="mysql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost/CHANGE_ME_DATABASE?unix_socket=/var/run/mysqld/mysqld.sock&serverVersion=8.0.33&charset=utf8mb4"

# --- Firebase ------------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=CHANGE_ME
# Either the service-account JSON on one line, or a path inside the container - then uncomment the
# firebase.json volume in compose.yaml and set this to /run/secrets/firebase.json.
FIREBASE_CREDENTIALS=

# --- Anthropic (admin AI description generator) --------------------------------------------------
ANTHROPIC_API_KEY=

# --- CORS ----------------------------------------------------------------------------------------
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
